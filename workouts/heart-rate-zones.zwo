        <FreeRide Duration="300" HeartRate="130"/>
        <FreeRide Duration="120" HeartRate="115"/>
        <FreeRide Duration="240" HeartRate="145"/>
        <FreeRide Duration="180" HeartRate="115"/>
    </workout>
</workout_file>
